rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and role verification
    function signedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getUserData().role == 'admin'
        && getUserData().disabled != true;
    }

    function isViewer() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (getUserData().role == 'admin' || getUserData().role == 'viewer')
        && getUserData().disabled != true;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (getUserData().role == 'admin' || getUserData().role == 'staff')
        && getUserData().disabled != true;
    }

    // User profiles collection
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin() || (signedIn() && request.auth.token.email != null && resource.data.email != null && request.auth.token.email.lower() == resource.data.email.lower());
    }

    // Global site settings
    match /siteSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tshirtOrders/{orderId} {
      function validQuantity(value) {
        return value is int && value >= 0 && value <= 99;
      }

      function validOrder(data) {
        return data.keys().hasAll(['uid', 'name', 'email', 'phone', 'location', 'commune', 'place', 'sizes', 'createdAt'])
          && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'location', 'commune', 'place', 'sizes', 'createdAt'])
          && data.uid == request.auth.uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 120
          && data.email is string && data.email.size() <= 254 && data.email.matches('^.+@.+$')
          && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40
          && data.location in ['Bukavu', 'À l\'événement']
          && data.commune is string && data.place is string
          && ((data.location == 'Bukavu'
            && data.commune in ['Ibanda', 'Kadutu', 'Bagira']
            && data.place in ['Place Mulamba', 'Place du 24', 'Place de la Paix', 'Poste', 'Feu vert', 'Feu rouge', 'Cap Nguba', 'Rond-point ISP', 'Lycée Wima', 'Campus Mulindwa (UCB)', 'Campus Bugabo (UCB)', 'Campus Karhale (UCB)'])
            || (data.location == 'À l\'événement' && data.commune == '' && data.place == ''))
          && data.sizes is map && data.sizes.keys().hasAll(['S', 'M', 'L', 'XL', 'XXL'])
          && data.sizes.keys().hasOnly(['S', 'M', 'L', 'XL', 'XXL'])
          && validQuantity(data.sizes.S) && validQuantity(data.sizes.M) && validQuantity(data.sizes.L)
          && validQuantity(data.sizes.XL) && validQuantity(data.sizes.XXL)
          && (data.sizes.S + data.sizes.M + data.sizes.L + data.sizes.XL + data.sizes.XXL) > 0
          && data.createdAt == request.time;
      }

      allow create: if signedIn() && validOrder(request.resource.data);
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Event edition documents and subcollections
    match /events/{editionId} {
      allow read: if true;
      allow write: if isAdmin();

      // Live sessions and questions
      match /sessions/{sessionId} {
        allow read: if true;
        allow write: if isAdmin() || isViewer();

        match /questions/{questionId} {
          allow read: if true;
          // Allows both anonymous and Google signed-in users to post questions
          allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
          allow update, delete: if isAdmin() || isViewer();
        }
      }

      // User question quotas
      match /questionQuotas/{uid} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if isAdmin();
      }

      // CMS Collections: Public read for site display, admin-only write
      match /speakers/{speakerId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /agenda/{agendaItemId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /faq/{faqId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /partners/{partnerId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /news/{articleId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /gallery/{imageId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /albums/{albumId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Remote presentation control (readable by audience/display, writable by presenters)
      match /remote/{remoteId} {
        allow read: if true;
        allow write: if isViewer();
      }

      // Live emoji reactions
      match /emojis/{reactionId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }
  }
}

